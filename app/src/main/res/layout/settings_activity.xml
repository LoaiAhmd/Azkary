<LinearLayout
        xmlns:tools="http://schemas.android.com/tools" android:id="@+id/id_settings"
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <androidx.appcompat.widget.Toolbar
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/system_control_activated_light"
                app:title="@string/string_settings"
                app:titleTextColor="@color/white"
                tools:targetApi="34"/>

    <LinearLayout
            android:id="@+id/id_settings_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@color/cardview_shadow_start_color"
    >
        <Switch
                android:id="@+id/id_switch_add_widget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/string_add_widget"
                android:textSize="20sp"
                android:layout_marginBottom="20dp"
                style="@style/TextAppearance.Material3.BodyLarge"
        />
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp"
        >
            <Switch
                    android:id="@+id/id_switch_hide_notfications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/string_auto_hide_notfications"
                    android:textSize="20sp"

                    style="@style/TextAppearance.Material3.BodyLarge"
                    tools:ignore="TouchTargetSizeCheck"/>
        </LinearLayout>

        <Switch
                android:id="@+id/id_switch_dark_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/string_dark_mode"
                android:textSize="20sp"
                android:layout_marginBottom="20dp"
                style="@style/TextAppearance.Material3.BodyLarge"
                android:minHeight="48dp"/>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:contextClickable="true"
                android:layout_marginBottom="20dp"
        >
            <Switch
                    android:id="@+id/id_switch_clock_morning_azkar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/string_clock_morning_azkar"
                    android:textSize="25sp"
                    android:minHeight="48dp"/>
            <TextClock
                    android:id="@+id/id_clock_morning_azkar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:textSize="30sp"
            />
        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:contextClickable="true"
                android:layout_marginBottom="20dp"
        >
            <Switch
                    android:id="@+id/id_switch_clock_evening_azkar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/string_clock_evening_azkar"
                    android:textSize="25sp"
                    android:minHeight="48dp"/>
            <TextClock
                    android:id="@+id/id_clock_evening_azkar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:textSize="30sp"
            />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>