<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".SleepingAzkar">

    <androidx.appcompat.widget.Toolbar
            style="@style/ToolBarStyle"
            android:id="@+id/id_sleep_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/string_sleeping_azkar"
            tools:ignore="MissingConstraints"

    >
        <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/sleep"
                android:layout_gravity="left"
                android:layout_marginHorizontal="10dp"
        />
    </androidx.appcompat.widget.Toolbar>

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/id_sleep_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/id_sleep_toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:listitem="@layout/item_zekr"
    />

</androidx.constraintlayout.widget.ConstraintLayout>