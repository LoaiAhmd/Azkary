<RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools" xmlns:app="http://schemas.android.com/apk/res-auto"
        style="@style/Widget.MyApplication.AppWidget.Container"
        android:theme="@style/Theme.MyApplication.AppWidgetContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gray_light"
        android:id="@+id/id_widget_layout"
>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            >

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="10dp">

            <ImageButton
                    android:id="@+id/id_opacity_widget"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:src="@drawable/transparency"
                    android:background="@null"
                    android:layout_weight="1"
                    tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck"/>

            <ImageButton
                    android:id="@+id/id_refresh_zekir"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:src="@drawable/refresh"
                    android:background="@null"
                    android:tint="@color/black"
                    tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck,UseAppTint"/>
        </LinearLayout>

        <TextView
                style="@style/Widget.MyApplication.AppWidget.InnerView"
                android:id="@+id/id_widget_txtv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_weight="1"
                android:background="@color/black"
                android:textColor="@color/white"
        />

    </LinearLayout>

</RelativeLayout>