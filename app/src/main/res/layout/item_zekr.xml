<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
        android:id="@+id/id_cardview"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginLeft="10dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/cyan_light"
        app:strokeColor="@android:color/black"
        app:strokeWidth="2dp"
>


    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            tools:context=".box"
    >


        <TextView
                android:id="@+id/id_zekr_box"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="@color/black"
                android:textAlignment="center"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintHorizontal_bias="0.0" app:layout_constraintVertical_bias="0.206"/>

        <Button
                android:id="@+id/id_count_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/string_count"
                android:textColor="@color/cyan_light"
                android:textStyle="bold"
                android:textSize="30sp"
                android:backgroundTint="@color/gray_light"
                android:layout_margin="10dp"
                app:layout_constraintTop_toBottomOf="@+id/id_zekr_box"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/id_copy_btn"
                app:layout_constraintVertical_bias="0.0"/>

        <ImageButton
                android:id="@+id/id_copy_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/copy"
                android:background="@null"
                android:scaleX="1.5"
                android:scaleY="1.5"
                android:layout_margin="10dp"
                app:layout_constraintTop_toBottomOf="@+id/id_zekr_box"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/id_count_btn"
                app:layout_constraintVertical_bias="0.45"
        />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
