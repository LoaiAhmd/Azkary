<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
        style="@style/CardViewStyle"
        android:id="@+id/id_cardview_item_zekr"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:outlineSpotShadowColor="@android:color/transparent"
>


    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context=".box"
    >

        <TextView
                android:id="@+id/id_txt_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textColor="@color/red"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="MissingConstraints"/>

        <TextView
                android:id="@+id/id_zekr_box"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textAlignment="center"
                android:layout_marginHorizontal="20dp"
                style="@style/Text"
                app:layout_constraintTop_toBottomOf="@id/id_txt_note"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintVertical_bias="0.0"/>
        <Button
                style="@style/Text"
                android:id="@+id/id_count_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/string_count"
                android:textSize="30sp"
                android:backgroundTint="@android:color/transparent"
                android:textStyle="italic|bold"
                android:layout_margin="10dp"
                app:layout_constraintTop_toBottomOf="@+id/id_zekr_box"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/id_copy_btn"
                app:layout_constraintVertical_bias="0.0"/>

        <ImageButton
                style="@style/MyImageButtonStyle"
                android:id="@+id/id_copy_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/copy"
                android:background="@null"
                android:layout_margin="10dp"
                app:layout_constraintTop_toBottomOf="@+id/id_zekr_box"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/id_count_btn"
                app:layout_constraintVertical_bias="0.686"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
