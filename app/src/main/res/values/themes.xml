<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light/dark theme colors here -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication">
    </style>

    <!-- Widget container styles -->
    <style name="Theme.MyApplication.AppWidgetContainerParent" parent="@android:style/Theme.DeviceDefault">
        <item name="appWidgetRadius">16dp</item>
        <item name="appWidgetInnerRadius">8dp</item>
    </style>

    <style name="Theme.MyApplication.AppWidgetContainer"
           parent="Theme.MyApplication.AppWidgetContainerParent">
        <item name="appWidgetPadding">16dp</item>
    </style>

    <!-- Screen -->
    <style name="Screen">
        <item name="background">@color/gray_light</item>
    </style>

    <!-- Text -->
    <style name="Text">
        <item name="android:textColor"> @color/black </item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Button -->
    <style name="Button">
        <item name="android:backgroundTint">@color/black</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- Container -->
    <style name="MyContainer">
        <item name="android:background">@color/gray_light</item>
    </style>

    <!-- CheckBox -->
    <style name="MyCheckBox">
        <item name="android:buttonTint">@color/white</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- ImageButton -->
    <style name="MyImageButtonStyle">
        <item name="android:tint">@color/black</item>
    </style>

    <!-- ToolBar -->
    <style name="ToolBarStyle">
        <item name="android:background">@color/cyan_light</item>
        <item name="titleTextColor">@color/black</item>
        <item name="titleTextStyle">@style/Text</item>
    </style>

    <!-- CardView -->
    <style name="CardViewStyle">
        <item name="cardBackgroundColor">@color/cyan_light</item>
        <item name="cardCornerRadius"> 20dp </item>
    </style>

    <!-- EditText -->
    <style name="EditTextStyle">
        <item name="android:background">@color/gray_light</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- MainActvBtn -->
    <style name="MainActvBtnStyle">
        <item name="android:backgroundTint">@color/cyan_light</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- ButtonNavStyle -->
    <style name="ButtonNavStyle">
        <item name="backgroundTint">@color/cyan_light</item>
        <item name="android:textColor"> @color/black </item>
        <item name="iconTint"> @color/black </item>
    </style>

</resources>